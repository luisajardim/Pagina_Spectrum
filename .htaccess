# Spectrum: configuração para Apache (HostGator)

Options -Indexes
DirectoryIndex index.php
AddDefaultCharset UTF-8
AddType image/webp .webp

# --- Arquivos que nunca devem ser servidos ---
<FilesMatch "^(\.env.*|\.git.*|router\.php|README\.md|spectrumprototipo.*\.html)$">
    Require all denied
</FilesMatch>

<IfModule mod_rewrite.c>
    RewriteEngine On

    # Força HTTPS. Ative (remova os #) depois que o certificado SSL
    # estiver ativo no cPanel.
    # RewriteCond %{HTTPS} !=on
    # RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

    # Pastas internas
    RewriteRule ^(app|\.git)(/|$) - [F,L]

    # Tudo que não for arquivo existente vai para o index.php
    # (ele trata as URLs das páginas, a barra final e o 404).
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteRule ^ index.php [L]
</IfModule>

ErrorDocument 404 /index.php

# --- Cabeçalhos de segurança ---
<IfModule mod_headers.c>
    Header always set X-Content-Type-Options "nosniff"
    Header always set X-Frame-Options "SAMEORIGIN"
    Header always set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>

# --- Compressão ---
<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/html text/css application/javascript image/svg+xml
</IfModule>

# --- Cache do navegador (CSS/JS levam ?v= com a data do arquivo) ---
<IfModule mod_expires.c>
    ExpiresActive On
    ExpiresByType text/css "access plus 1 year"
    ExpiresByType application/javascript "access plus 1 year"
    ExpiresByType image/webp "access plus 1 year"
    ExpiresByType image/png "access plus 1 month"
    ExpiresByType image/jpeg "access plus 1 month"
    ExpiresByType image/x-icon "access plus 1 month"
    ExpiresByType application/pdf "access plus 1 month"
</IfModule>
