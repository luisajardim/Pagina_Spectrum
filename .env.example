# Copie este arquivo para ".env" e preencha os valores.
# Na hospedagem, coloque o .env FORA do public_html (uma pasta acima),
# ex.: /home/USUARIO/.env. O site procura lá primeiro e depois na raiz.
# O .env nunca deve ir para o Git.

# Endereço público do site (canonical, Open Graph). Sem barra no final.
SITE_URL=https://www.spectrumbh.com.br

# Texto aleatório e longo usado para assinar o token anti-spam dos formulários.
# Gere um, por exemplo, em https://www.random.org/strings/ ou com:
#   php -r "echo bin2hex(random_bytes(32));"
APP_SECRET=

# ---------------------------------------------------------------------------
# Envio de e-mail
#   smtp = envio autenticado (recomendado em produção)
#   mail = função mail() do servidor (alternativa se o SMTP for bloqueado)
#   log  = não envia; grava cada e-mail em app/storage/emails/ (desenvolvimento)
# ---------------------------------------------------------------------------
MAIL_TRANSPORT=log

# HostGator: crie no cPanel uma conta como site@spectrumbh.com.br e use os
# dados de "Configurar cliente de e-mail" (servidor de saída SMTP).
SMTP_HOST=mail.spectrumbh.com.br
# 465 com SMTP_SECURE=ssl  |  587 com SMTP_SECURE=tls
SMTP_PORT=465
SMTP_SECURE=ssl
SMTP_USER=site@spectrumbh.com.br
SMTP_PASS=

# Remetente dos e-mails (deve ser uma conta do próprio domínio).
MAIL_FROM=site@spectrumbh.com.br
MAIL_FROM_NAME=Site Spectrum

# Opcional, para testes: se preenchido, TODOS os formulários vão para este(s)
# endereço(s) em vez dos destinatários reais. Deixe vazio em produção.
MAIL_TEST_TO=

# ---------------------------------------------------------------------------
# Cloudflare Turnstile (captcha). Se vazio, os formulários usam só o honeypot
# e o controle de tempo. Crie as chaves gratuitas em
# https://dash.cloudflare.com → Turnstile → Add widget (domínio do site).
# Chaves de teste da Cloudflare (sempre aprovam, invisíveis):
#   TURNSTILE_SITE_KEY=1x00000000000000000000BB
#   TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA
# ---------------------------------------------------------------------------
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
